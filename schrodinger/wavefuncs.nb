Cell[BoxData[{
 RowBox[{
  RowBox[{"$Assumptions", "=", 
   RowBox[{
    RowBox[{"Element", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "x", ",", "\[Mu]x", ",", "\[Mu]p", ",", "\[Sigma]x", ",", "\[HBar]"}], 
       "}"}], ",", "Reals"}], "]"}], "&&", 
    RowBox[{"\[Sigma]x", ">", "0"}], "&&", 
    RowBox[{"\[HBar]", ">", "0"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Phi]", "[", "x_", "]"}], "=", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"2", "\[Pi]", " ", 
       SuperscriptBox["\[Sigma]x", "2"]}], ")"}], 
     RowBox[{"-", 
      FractionBox["1", "4"]}]], 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", 
       FractionBox[
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"x", "-", "\[Mu]x"}], ")"}], "2"], 
        RowBox[{"4", 
         SuperscriptBox["\[Sigma]x", "2"]}]]}], "+", 
      RowBox[{
       FractionBox["\[ImaginaryI]", "\[HBar]"], " ", "x", " ", "\[Mu]p", 
       " "}]}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Psi]", "[", "p_", "]"}], ":=", 
    RowBox[{
     FractionBox["1", 
      SqrtBox[
       RowBox[{"2", "\[Pi]", " ", "\[HBar]"}]]], 
     RowBox[{
      SubsuperscriptBox["\[Integral]", 
       RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
      RowBox[{
       RowBox[{"\[Phi]", "[", "x", "]"}], 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", 
          FractionBox["\[ImaginaryI]", "\[HBar]"]}], " ", "p", " ", "x"}]], 
       RowBox[{"\[DifferentialD]", "x"}]}]}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"moment", "[", 
    RowBox[{"J_", ",", "n_"}], "]"}], ":=", 
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
    RowBox[{
     SuperscriptBox["z", "n"], 
     RowBox[{
      RowBox[{"J", "[", "z", "]"}], "\[Conjugate]"}], 
     RowBox[{"J", "[", "z", "]"}], 
     RowBox[{"\[DifferentialD]", "z"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"norm", "[", "J_", "]"}], "=", 
   RowBox[{"moment", "[", 
    RowBox[{"J", ",", "0"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"mean", "[", "J_", "]"}], "=", 
